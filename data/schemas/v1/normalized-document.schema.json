{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ancient-text-lab.example/schemas/v1/normalized-document.schema.json",
  "title": "Normalized document",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_artifact_id", "script", "units", "transformations"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source_artifact_id": {"type": "string", "minLength": 1},
    "script": {"type": "string", "minLength": 1},
    "transformations": {"type": "array"},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "document_id", "position", "signs", "annotations"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "document_id": {"type": "string", "minLength": 1},
          "position": {"type": "integer", "minimum": 0},
          "signs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "annotations": {"type": "object"}
        }
      }
    }
  }
}
