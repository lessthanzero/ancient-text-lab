{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ancient-text-lab.example/schemas/v1/evidence-record.schema.json",
  "title": "Evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "layer", "source_artifact_ids", "researcher", "confidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "layer": {"enum": ["observation", "transcription", "interpretation", "hypothesis"]},
    "source_artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "researcher": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "notes": {"type": ["string", "null"]}
  }
}
