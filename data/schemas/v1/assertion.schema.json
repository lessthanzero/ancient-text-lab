{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ancient-text-lab.example/schemas/v1/assertion.schema.json",
  "title": "Research assertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "status", "claim", "evidence_ids", "confidence", "verification_evidence_ids", "promoted_from_assertion_id"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["transcription", "interpretation", "hypothesis"]},
    "status": {"enum": ["proposed", "active", "supported", "falsified", "verified"]},
    "claim": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verification_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "promoted_from_assertion_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "verified"}}},
      "then": {
        "properties": {
          "verification_evidence_ids": {"minItems": 1},
          "promoted_from_assertion_id": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
